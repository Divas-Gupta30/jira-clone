          }
        }
      ]
    },
    {
      "name": "Activity & Search",
      "item": [
        {
          "name": "Activity feed",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{leadUserId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/projects/{{projectId}}/activity?limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "projects", "{{projectId}}", "activity"],
              "query": [{ "key": "limit", "value": "10" }]
            }
          }
        },
        {
          "name": "Search by text",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{memberUserId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/search?q=OAuth&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "search"],
              "query": [
                { "key": "q", "value": "OAuth" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Search with filter",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{memberUserId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/search?filter=type = \"STORY\"&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "search"],
              "query": [
                { "key": "filter", "value": "type = \"STORY\"" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Auth & RBAC",
      "item": [
        {
          "name": "Missing X-User-Id (expect 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/board"
          }
        },
        {
          "name": "Viewer cannot create issue (expect 403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{viewerUserId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"TASK\",\n  \"title\": \"Not allowed\",\n  \"priority\": \"LOW\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/issues"
          }
        },
        {
          "name": "Member cannot access admin (expect 403)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{memberUserId}}" }
            ],
            "url": "{{baseUrl}}/api/v1/admin/seed"
          }
        }
      ]
    },
    {
      "name": "WebSocket",
      "description": "Requires Postman v10+. Open a WS request → Connect → keep tab open. Run **Triggers (HTTP)** in another tab to see events.\n\nEvents: `presence`, `issue_created`, `issue_updated`, `issue_moved`, `comment_added`, `sprint_updated`",
      "item": [
        {
          "name": "Connections",
          "item": [
            {
              "name": "Board WS — user_lead",
              "protocolProfileBehavior": {
                "protocolVersion": "webSocket"
              },
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{wsUrl}}/ws/board?project_id={{projectId}}&user_id={{leadUserId}}"
              },
              "message": [
                {
                  "type": "send",
                  "message": "ping"
                }
              ]
            },
            {
              "name": "Board WS — user_member",
              "protocolProfileBehavior": {
                "protocolVersion": "webSocket"
              },
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{wsUrl}}/ws/board?project_id={{projectId}}&user_id={{memberUserId}}"
              },
              "message": [
                {
                  "type": "send",
                  "message": "ping"
                }
              ]
            },
            {
              "name": "Board WS — missing project_id (expect close)",
              "protocolProfileBehavior": {
                "protocolVersion": "webSocket"
              },
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{wsUrl}}/ws/board?user_id={{leadUserId}}"
              }
            }
          ]
        },
        {
          "name": "Triggers (HTTP)",
          "description": "Run while a WebSocket connection is open on the same project_id.",
          "item": [
            {
              "name": "Trigger — create issue (issue_created)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "  const body = pm.response.json();",
                      "  pm.collectionVariables.set('wsIssueId', body.issueId);",
                      "  pm.collectionVariables.set('wsIssueVersion', String(body.version));",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "X-User-Id", "value": "{{memberUserId}}" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"type\": \"TASK\",\n  \"title\": \"WebSocket test issue\",\n  \"priority\": \"MEDIUM\",\n  \"labels\": [\"websocket\"]\n}"
                },
                "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/issues"
              }
            },
            {
              "name": "Trigger — transition In Progress (issue_moved)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "  pm.collectionVariables.set('wsIssueVersion', String(pm.response.json().version));",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "X-User-Id", "value": "{{memberUserId}}" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"toStatus\": \"In Progress\",\n  \"version\": {{wsIssueVersion}}\n}"
                },
                "url": "{{baseUrl}}/api/v1/issues/{{wsIssueId}}/transitions"
              }
            },
            {
              "name": "Trigger — add comment (comment_added)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "X-User-Id", "value": "{{leadUserId}}" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"body\": \"WS demo comment @user_member\",\n  \"parentId\": null\n}"
                },
                "url": "{{baseUrl}}/api/v1/issues/{{wsIssueId}}/comments"
              }
            },
            {
              "name": "Trigger — update issue (issue_updated)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "  pm.collectionVariables.set('wsIssueVersion', String(pm.response.json().version));",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "PATCH",
                "header": [
                  { "key": "X-User-Id", "value": "{{memberUserId}}" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"version\": {{wsIssueVersion}},\n  \"title\": \"WebSocket test issue (updated)\"\n}"
                },
                "url": "{{baseUrl}}/api/v1/issues/{{wsIssueId}}"
              }
            },
            {
              "name": "Trigger — start sprint (sprint_updated)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "X-User-Id", "value": "{{leadUserId}}" }
                ],
                "url": "{{baseUrl}}/api/v1/sprints/{{sprintId}}/start"
              }
            },
            {
              "name": "Trigger — comment on PROJ-123 (comment_added)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "X-User-Id", "value": "{{leadUserId}}" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"body\": \"WebSocket trigger on seed issue @user_member\",\n  \"parentId\": null\n}"
                },
                "url": "{{baseUrl}}/api/v1/issues/PROJ-123/comments"
              }
            }
          ]
        },
        {
          "name": "Demo flow (manual)",
          "description": "1. Open **Board WS — user_lead** → Connect\n2. Open **Board WS — user_member** in new tab → Connect → see `presence` with both users\n3. Run **Trigger — create issue** → see `issue_created` in both WS tabs\n4. Run **Trigger — transition** → see `issue_moved`\n5. Run **Trigger — add comment** → see `comment_added`\n6. Disconnect one WS tab → `presence` updates in the other",
          "item": [
            {
              "name": "README — see folder description",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/api/health/live"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Flows",
      "description": "Run requests in order. Tests chain issueId and issueVersion between steps.",
      "item": [
        {
          "name": "1 — Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health/ready"
          }
        },
        {
          "name": "2 — Get board (seed data)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{memberUserId}}" }
            ],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/board"
          }
        },
        {
          "name": "3 — Create issue",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created issue', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('issueId', body.issueId);",
                  "pm.collectionVariables.set('issueVersion', String(body.version));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{memberUserId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"TASK\",\n  \"title\": \"Flow test task\",\n  \"priority\": \"MEDIUM\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/issues"
          }
        },
        {
          "name": "4 — Transition to In Progress",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Transitioned', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('issueVersion', String(pm.response.json().version));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{memberUserId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"toStatus\": \"In Progress\",\n  \"version\": {{issueVersion}}\n}"
            },
            "url": "{{baseUrl}}/api/v1/issues/{{issueId}}/transitions"
          }
        },
        {
          "name": "5 — Add comment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{leadUserId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Flow test comment @user_member\",\n  \"parentId\": null\n}"
            },
            "url": "{{baseUrl}}/api/v1/issues/{{issueId}}/comments"
          }
        },
        {
          "name": "6 — Activity feed",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{leadUserId}}" }
            ],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/activity?limit=5"
          }
        },
        {
          "name": "7 — Admin: create demo project",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('demoProjectId', pm.response.json().id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Admin-Key", "value": "{{adminApiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"proj_demo\",\n  \"key\": \"DEMO\",\n  \"name\": \"Postman Demo\",\n  \"adminUserId\": \"user_admin\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/seed/projects"
          }
        },
        {
          "name": "8 — Admin: create issue on demo project",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{adminUserId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"TASK\",\n  \"title\": \"First DEMO issue\",\n  \"priority\": \"LOW\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/projects/{{demoProjectId}}/issues"
          }
        },
        {
          "name": "9 — Admin: cleanup demo project",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-Admin-Key", "value": "{{adminApiKey}}" }
            ],
            "url": "{{baseUrl}}/api/v1/admin/seed/projects/{{demoProjectId}}"
          }
        }
      ]
    }
  ]
}
